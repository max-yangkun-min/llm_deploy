FROM glm52-vllm:0.24.0-pr38476-cu128-native-r570-a100

ARG PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ENV VLLM_ATTENTION_BACKEND=TRITON_MLA_SPARSE \
    VLLM_USE_DEEP_GEMM=0 \
    PYTHONFAULTHANDLER=1 \
    TORCH_SHOW_CPP_STACKTRACES=1 \
    PYTHONUNBUFFERED=1

RUN python3 -m pip config set global.index-url "${PYPI_INDEX}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends libcairo2-dev pkg-config \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m pip install --no-cache-dir pycairo==1.28.0 \
 && python3 -m pip install --force-reinstall --no-deps --no-cache-dir nixl-cu12==1.2.0

COPY verify_stack.py /opt/verify_stack.py
COPY validate-image.sh /opt/validate-image.sh
RUN python3 -m pip check \
 && python3 /opt/verify_stack.py \
 && python3 -m pip freeze --all | sort > /opt/glm52-vllm-pip-freeze.txt

ENTRYPOINT []
CMD ["bash"]
