# syntax=docker/dockerfile:1.7
# ============================================================================
# GLM-5.2 · 8×A100 · vLLM + PR #38476 —— 【国内源版】
# 与原版 Dockerfile 等价,但把 apt / pip / git / CUDA base 全走国内可达路径,
# 便于在国内带宽受限的机器上构建。差异:
#   - apt   -> 清华镜像
#   - pip   -> 清华 PyPI
#   - git   -> GitHub 代理前缀(GH_PROXY)
#   - FROM  -> 可选 Docker Hub 镜像前缀(CUDA_REGISTRY)
#   - patch -> 直接套已就位的 PR#38476 patch(不再 fetch PR/cherry-pick,省一个易断网络环节)
#
# 构建示例:
#   # (可选,推荐)先在联网机把 precompiled wheel 下到 scripts/wheels/,走清华源快:
#   pip download vllm==0.24.0 --no-deps -d wheels/ -i https://pypi.tuna.tsinghua.edu.cn/simple
#   docker build -f Dockerfile.cn \
#     --build-arg CUDA_REGISTRY=docker.m.daocloud.io/ \   # ← 换成你当前可用的镜像;留空则直连 Docker Hub
#     --build-arg GH_PROXY=https://ghfast.top/ \          # ← 换成你当前可用的 GitHub 代理
#     --build-arg VLLM_REF=v0.24.0 \
#     --build-arg PRECOMPILED_WHEEL=vllm-0.24.0-cp38-abi3-manylinux1_x86_64.whl \  # ← 上一步下到的文件名;留空则 vLLM 自拉
#     -t glm52-vllm:0.24.0-pr38476 .
#
# 若 CUDA base 仍拉不动:先在别处 `docker pull <可用镜像>/nvidia/cuda:12.8.1-devel-ubuntu22.04`
#   再 `docker tag` 成 nvidia/cuda:12.8.1-devel-ubuntu22.04,然后用原版 Dockerfile 构建(FROM 命中本地)。
# ============================================================================

ARG CUDA_REGISTRY=
FROM ${CUDA_REGISTRY}nvidia/cuda:12.8.1-devel-ubuntu22.04

ARG VLLM_REF=v0.24.0
# 国内镜像(都可用 --build-arg 覆盖成当前可用的)
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ARG GH_PROXY=https://ghfast.top/
# 预置 precompiled wheel(避开 vLLM 自有存储的慢下载)。三种取值:
#   空        = 不用,vLLM 自己去它的存储拉(国内可能慢)
#   http...   = 直接指向一个 wheel URL(如清华镜像上的 vllm wheel)
#   文件名     = 放在 scripts/wheels/ 里的本地 wheel 文件名(会被 COPY 进镜像)
ARG PRECOMPILED_WHEEL=

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

# ── apt 换清华源(ubuntu22.04=jammy;兼容 sources.list 与 ubuntu.sources 两种布局)──
RUN set -eux; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i "s@//.*archive.ubuntu.com@//${APT_MIRROR}@g; s@//.*security.ubuntu.com@//${APT_MIRROR}@g" /etc/apt/sources.list; \
    fi; \
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
      sed -i "s@//.*archive.ubuntu.com@//${APT_MIRROR}@g; s@//.*security.ubuntu.com@//${APT_MIRROR}@g" /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
      git python3.11 python3.11-venv python3.11-dev python3-pip \
      build-essential ca-certificates curl patch \
 && rm -rf /var/lib/apt/lists/* \
 && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# ── pip 全局换清华 ──
RUN python3 -m pip install --upgrade pip -i ${PIP_INDEX} \
 && pip config set global.index-url ${PIP_INDEX}

WORKDIR /opt
# ── git clone 走代理 + 浅克隆(只要该 tag,不要历史)──
RUN git clone --depth 1 --branch ${VLLM_REF} \
      ${GH_PROXY}https://github.com/vllm-project/vllm.git \
 && cd vllm && git rev-parse HEAD > /opt/vllm_commit.txt && git log --oneline -1
WORKDIR /opt/vllm

# ── 直接套 PR#38476 patch(已随镜像 COPY,无需联网 fetch PR)──
# 三段兜底:--3way(有基线blob时)→ 普通 apply(上下文匹配)→ patch -p1(模糊匹配,最后兜底)
COPY patches/ /opt/patches/
RUN set -eux; P=/opt/patches/38476-with-triton-fallback.patch; \
    [ -f "$P" ] || { echo "!! 缺 $P"; exit 1; }; \
    git apply --3way "$P" \
      || git apply "$P" \
      || patch -p1 < "$P" \
      || { echo "!! patch 三种方式都失败:该 VLLM_REF 与 PR 漂移过大,换个 tag 或按 patches/README.md 手工解"; exit 1; }

# ── 纯 Python 改动,不重编 CUDA。可选:用预置 precompiled wheel 避开慢下载 ──
# scripts/wheels/ 总是被 COPY(可能只含 .gitkeep);PRECOMPILED_WHEEL 决定是否启用。
COPY wheels/ /opt/wheels/
RUN set -eux; \
    if [ -n "${PRECOMPILED_WHEEL}" ]; then \
      case "${PRECOMPILED_WHEEL}" in \
        http*) export VLLM_PRECOMPILED_WHEEL_LOCATION="${PRECOMPILED_WHEEL}" ;; \
        *)     export VLLM_PRECOMPILED_WHEEL_LOCATION="/opt/wheels/${PRECOMPILED_WHEEL}"; \
               [ -f "${VLLM_PRECOMPILED_WHEEL_LOCATION}" ] \
                 || { echo "!! 未找到 /opt/wheels/${PRECOMPILED_WHEEL},请把 wheel 放进 scripts/wheels/ 再构建"; exit 1; } ;; \
      esac; \
      echo ">> 使用预置 precompiled wheel: ${VLLM_PRECOMPILED_WHEEL_LOCATION}"; \
    else \
      echo ">> 未指定 PRECOMPILED_WHEEL,vLLM 将自行拉取(国内可能慢)"; \
    fi; \
    VLLM_USE_PRECOMPILED=1 pip install -e . \
 && pip install "huggingface_hub[hf_transfer]"
# 预下 wheel(在联网机,走清华源,快):
#   pip download vllm==${VLLM_REF#v} --no-deps -d scripts/wheels/ -i https://pypi.tuna.tsinghua.edu.cn/simple
#   再构建:--build-arg PRECOMPILED_WHEEL=vllm-<版本>-<abi>-<平台>.whl

# ── A100 兜底三件套 + hf_transfer,固化进镜像 ──
ENV VLLM_ATTENTION_BACKEND=TRITON_MLA_SPARSE \
    VLLM_USE_DEEP_GEMM=0 \
    VLLM_USE_FLASHINFER_SAMPLER=0 \
    HF_HUB_ENABLE_HF_TRANSFER=1

EXPOSE 8000
WORKDIR /opt/vllm
CMD ["bash"]
