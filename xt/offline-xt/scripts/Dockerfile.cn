# syntax=docker/dockerfile:1.7
# ============================================================================
# xt · CUDA 12.4【国内源版】—— 与 Dockerfile 等价,只把镜像来源/pip 走国内。
# 比 kty5l 的简单得多:无 git clone、无 patch、无 precompiled wheel,唯一大件是官方镜像本身。
# 构建示例:
#   docker build -f Dockerfile.cn \
#     --build-arg VLLM_BASE_IMAGE=docker.m.daocloud.io/vllm/vllm-openai:v0.24.0 \
#     --build-arg VLLM_TAG=v0.24.0 -t xt-vllm:0.24.0-cu124 .
# 若镜像仍拉不动:在别处预拉后推到内部仓库,再用VLLM_BASE_IMAGE指向它。
# ============================================================================
ARG VLLM_TAG=v0.24.0
ARG VLLM_BASE_IMAGE=docker.m.daocloud.io/vllm/vllm-openai:v0.24.0
FROM ${VLLM_BASE_IMAGE}

ARG VLLM_TAG
ARG VLLM_BASE_IMAGE
ARG CUDA_COMPAT=12.4

# cu124 是硬约束。失败表示这个官方 tag 不是 CUDA 12.4 构建,必须换 tag。
RUN CUDA_COMPAT="${CUDA_COMPAT}" python3 -c 'import os, torch; expected=os.environ["CUDA_COMPAT"]; actual=torch.version.cuda or ""; assert actual == expected or actual.startswith(expected + "."), f"expected CUDA {expected}, got torch CUDA {actual}"; print(f"verified torch CUDA {actual}")'

RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
      "huggingface_hub[hf_transfer]" || true

ENV HF_HUB_ENABLE_HF_TRANSFER=1
LABEL org.blade-agent.cuda-profile="cu124" \
      org.blade-agent.cuda-runtime="${CUDA_COMPAT}" \
      org.blade-agent.vllm-tag="${VLLM_TAG}" \
      org.blade-agent.base-image="${VLLM_BASE_IMAGE}"
ENTRYPOINT []
CMD ["bash"]
